            <i class="fas fa-times text-xl"></i>
        </button>
        <!-- Prev Button -->
        <button onclick="prevImage()" class="absolute left-4 md:left-10 top-1/2 -translate-y-1/2 w-11 h-11 bg-white/10 hover:bg-[#38bdf8] rounded-full text-white flex items-center justify-center transition">
            <i class="fas fa-chevron-left"></i>
        </button>
        <!-- Next Button -->
        <button onclick="nextImage()" class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 w-11 h-11 bg-white/10 hover:bg-[#38bdf8] rounded-full text-white flex items-center justify-center transition">
            <i class="fas fa-chevron-right"></i>
        </button>
