    <script>
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('searchBtn');

            function doSearch() {
                let query = searchInput.value.toLowerCase().trim();
                if (!query) return;

                // কোন শব্দ লিখলে কোথায় যাবে
                if (query.includes('skill')) {
                    document.getElementById('skills')?.scrollIntoView({ behavior: 'smooth' });
                } else if (query.includes('project')) {
                    document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth' });
                } else if (query.includes('galler')) {
                    document.getElementById('gallery')?.scrollIntoView({ behavior: 'smooth' });
                } else if (query.includes('blog')) {
                    document.getElementById('blog')?.scrollIntoView({ behavior: 'smooth' });
                } else if (query.includes('about')) {
                    document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
                } else if (query.includes('contact') || query.includes('email') || query.includes('phone')) {
                    document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
                } else if (query.includes('home') || query.includes('fahim')) {
                    document.getElementById('home')?.scrollIntoView({ behavior: 'smooth' });
                } else {
                    alert('"' + query + '" - Nothing was found। Try: skills, projects, gallery, blog, about, contact');
                }
            }

            // Button Click করলে Search
            searchBtn.addEventListener('click', doSearch);

            // Enter চাপলেও Search হবে
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    doSearch();
                }
            });
    </script>
