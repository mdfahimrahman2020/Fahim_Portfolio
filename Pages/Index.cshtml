    </div>

    <script>
            let galleryImages = [];
            let currentIndex = 0;

            function openGallery(el) {
                const allImgs = document.querySelectorAll('#gallery [data-full]');
                galleryImages = Array.from(allImgs).map(img => ({
                    src: img.getAttribute('data-full') || img.src,
                    caption: img.parentElement.querySelector('p')?.innerText || ''
                }));
                const clickedSrc = el.querySelector('img').getAttribute('data-full') || el.querySelector('img').src;
                currentIndex = galleryImages.findIndex(i => i.src === clickedSrc);

                showImage();
                document.getElementById('galleryModal').classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }

            function showImage() {
                document.getElementById('modalImage').src = galleryImages[currentIndex].src;
                document.getElementById('modalCaption').innerText = galleryImages[currentIndex].caption;
            }

            function closeGallery() {
                document.getElementById('galleryModal').classList.add('hidden');
                document.body.style.overflow = 'auto';
            }
            function nextImage() {
                currentIndex = (currentIndex + 1) % galleryImages.length;
                showImage();
            }
            function prevImage() {
                currentIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
                showImage();
            }

            // বাইরে Click করলে Close হবে
            document.getElementById('galleryModal')?.addEventListener('click', (e) => {
                if (e.target.id === 'galleryModal') closeGallery();
            });
            // ESC, Arrow Key কাজ করবে
            document.addEventListener('keydown', (e) => {
                if (document.getElementById('galleryModal').classList.contains('hidden')) return;
                if (e.key === 'Escape') closeGallery();
                if (e.key === 'ArrowRight') nextImage();
                if (e.key === 'ArrowLeft') prevImage();
            });
    </script>



